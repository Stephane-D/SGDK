# get makefile path in unix format
MAKEFILE_PATH := $(subst \,/,$(lastword $(MAKEFILE_LIST)))
MAKEFILE_DIR := $(dir $(MAKEFILE_PATH))

# test if we have access to SGDK environment, if so we can override the GDK var
ifneq ($(wildcard $(MAKEFILE_DIR)bin/rescomp.jar),)
	GDK := $(patsubst %/,%,$(MAKEFILE_DIR))
else
    $(warning Cannot find SGDK environment ! Current folder = '${MAKEFILE_DIR}')
endif

include $(GDK)/common.mk

BUILD_TYPE := release
ifeq ($(MAKECMDGOALS),debug)
  	BUILD_TYPE := debug
else ifeq ($(MAKECMDGOALS),Debug)
  	BUILD_TYPE := debug
else ifeq ($(MAKECMDGOALS),clean-debug)
  	BUILD_TYPE := debug
else ifeq ($(MAKECMDGOALS),asm)
  	BUILD_TYPE := asm
else ifeq ($(MAKECMDGOALS),Asm)
  	BUILD_TYPE := asm
else ifeq ($(MAKECMDGOALS),clean-asm)
  	BUILD_TYPE := asm
endif

CLEAN := FALSE
ifeq ($(findstring clean,$(MAKECMDGOALS)),clean)
	CLEAN := TRUE
endif

SRC_DIR := src
RES_DIR := res
INC_DIR := inc
OUT_DIR := out/$(BUILD_TYPE)
DEP_DIR = $(OUT_DIR)/_deps
OUT_DIR_LIB := $(GDK)/$(OUT_DIR)
EXT_DEPS_DIR := deps

SRC_C = $(wildcard *.c)
SRC_C += $(wildcard $(SRC_DIR)/*.c)
SRC_C += $(wildcard $(SRC_DIR)/*/*.c)
SRC_C += $(wildcard $(SRC_DIR)/*/*/*.c)
SRC_C += $(wildcard $(SRC_DIR)/*/*/*/*.c)
SRC_C += $(wildcard $(SRC_DIR)/*/*/*/*/*.c)
SRC_C += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*.c)
SRC_C += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*.c)
SRC_C += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*.c)
SRC_C += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*/*.c)
SRC_C += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*/*/*.c)
SRC_C := $(filter-out $(SRC_DIR)/rom_header.c,$(SRC_C))
SRC_S = $(wildcard *.s)
SRC_S += $(wildcard $(SRC_DIR)/*.s)
SRC_S += $(wildcard $(SRC_DIR)/*/*.s)
SRC_S += $(wildcard $(SRC_DIR)/*/*/*.s)
SRC_S += $(wildcard $(SRC_DIR)/*/*/*/*.s)
SRC_S += $(wildcard $(SRC_DIR)/*/*/*/*/*.s)
SRC_S += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*.s)
SRC_S += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*.s)
SRC_S += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*.s)
SRC_S += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*/*.s)
SRC_S += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*/*/*.s)
SRC_ASM = $(wildcard *.asm)
SRC_ASM += $(wildcard $(SRC_DIR)/*.asm)
SRC_ASM += $(wildcard $(SRC_DIR)/*/*.asm)
SRC_ASM += $(wildcard $(SRC_DIR)/*/*/*.asm)
SRC_ASM += $(wildcard $(SRC_DIR)/*/*/*/*.asm)
SRC_ASM += $(wildcard $(SRC_DIR)/*/*/*/*/*.asm)
SRC_ASM += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*.asm)
SRC_ASM += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*.asm)
SRC_ASM += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*.asm)
SRC_ASM += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*/*.asm)
SRC_ASM += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*/*/*.asm)
SRC_ASM := $(SRC_ASM)
SRC_S80 = $(wildcard *.s80)
SRC_S80 += $(wildcard $(SRC_DIR)/*.s80)
SRC_S80 += $(wildcard $(SRC_DIR)/*/*.s80)
SRC_S80 += $(wildcard $(SRC_DIR)/*/*/*.s80)
SRC_S80 += $(wildcard $(SRC_DIR)/*/*/*/*.s80)
SRC_S80 += $(wildcard $(SRC_DIR)/*/*/*/*/*.s80)
SRC_S80 += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*.s80)
SRC_S80 += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*.s80)
SRC_S80 += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*.s80)
SRC_S80 += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*/*.s80)
SRC_S80 += $(wildcard $(EXT_DEPS_DIR)/*/$(SRC_DIR)/*/*/*/*/*/*.s80)
SRC_S80 := $(SRC_S80)

RES_RES = $(wildcard *.res)
RES_RES += $(wildcard $(RES_DIR)/*.res)
RES_RES += $(wildcard $(RES_DIR)/*/*.res)
RES_RES += $(wildcard $(RES_DIR)/*/*/*.res)
RES_RES += $(wildcard $(RES_DIR)/*/*/*/*.res)
RES_RES += $(wildcard $(RES_DIR)/*/*/*/*/*.res)
RES_RES += $(wildcard $(EXT_DEPS_DIR)/*/$(RES_DIR)/*.res)
RES_RES += $(wildcard $(EXT_DEPS_DIR)/*/$(RES_DIR)/*/*.res)
RES_RES += $(wildcard $(EXT_DEPS_DIR)/*/$(RES_DIR)/*/*/*.res)
RES_RES += $(wildcard $(EXT_DEPS_DIR)/*/$(RES_DIR)/*/*/*/*.res)
RES_RES += $(wildcard $(EXT_DEPS_DIR)/*/$(RES_DIR)/*/*/*/*/*.res)
RES_RES := $(RES_RES)

RES_O = $(RES_RES:.res=.o)
RES_O := $(addprefix $(OUT_DIR)/, $(RES_O))

OBJS = $(RES_RES:.res=.o)
OBJS += $(SRC_S80:.s80=.o)
OBJS += $(SRC_ASM:.asm=.o)
OBJS += $(SRC_S:.s=.o)
OBJS += $(SRC_C:.c=.o)
OBJS := $(addprefix $(OUT_DIR)/, $(OBJS))

LSTS := $(SRC_C:.c=.lst)
LSTS := $(addprefix $(OUT_DIR)/, $(LSTS))

DEPS = $(RES_RES:.res=.d)
DEPS += $(SRC_S:.s=.d)
DEPS += $(SRC_C:.c=.d)
DEPS := $(addprefix $(DEP_DIR)/, $(DEPS))

DEP_INC_DIRS = $(wildcard $(EXT_DEPS_DIR)/*/$(INC_DIR))

$(warning DEP_INC_DIRS=$(DEP_INC_DIRS))

INCS = -I. -I$(INC_DIR) -I$(RES_DIR) -I$(OUT_DIR)  $(addprefix -I,$(DEP_INC_DIRS)) -isystem$(INC_LIB) -isystem$(OUT_DIR_LIB)
DEFAULT_FLAGS := $(EXTRA_FLAGS) -DSGDK_GCC -m68000 -fdiagnostics-color=always -Wall -Wextra -Wno-shift-negative-value -Wno-main -Wno-unused-parameter -fno-builtin -ffunction-sections -fdata-sections -fms-extensions -B$(BIN)
Z80_FLAGS := -i. -i$(SRC_DIR) -i$(INC_DIR) -i$(RES_DIR) -i$(OUT_DIR) -i$(SRC_LIB) -i$(INC_LIB) -i$(INC_LIB)/snd -i$(OUT_DIR_LIB)

ifeq ($(BUILD_TYPE),debug)
	# debug
	FLAGS := $(INCS) $(DEFAULT_FLAGS) -O1 -DDEBUG=1
	CFLAGS := $(FLAGS) -ggdb -g
	AFLAGS := -x assembler-with-cpp -Wa,--register-prefix-optional,--bitwise-or $(FLAGS)
	LIBMD := $(LIB)/libmd_debug.a
else ifeq ($(BUILD_TYPE),asm)
	# asm
	FLAGS := $(INCS) $(DEFAULT_FLAGS) -O3 -fuse-linker-plugin -fno-web -fno-gcse -fno-tree-loop-ivcanon -fomit-frame-pointer
	CFLAGS := $(FLAGS)
	AFLAGS := -x assembler-with-cpp -Wa,--register-prefix-optional,--bitwise-or $(FLAGS)
	LIBMD := $(LIB)/libmd.a
else
	# release
	FLAGS := $(INCS) $(DEFAULT_FLAGS) -O3 -fuse-linker-plugin -fno-web -fno-gcse -fno-tree-loop-ivcanon -fomit-frame-pointer -flto -flto=auto -ffat-lto-objects
	CFLAGS := $(FLAGS)
	AFLAGS := -x assembler-with-cpp -Wa,--register-prefix-optional,--bitwise-or $(FLAGS)
	LIBMD := $(LIB)/libmd.a
endif

# --- Test configuration (Unity / CMock) ---
TEST_DIR ?= tests
ifneq ($(wildcard test/.*),)
    TEST_DIR := test
endif
TEST_OUT_DIR ?= out/test

TEST_DEPS_DIR := deps

# Unity and CMock sources (first match found or default location)
UNITY_SRCS = $(or $(firstword \
	$(wildcard $(TEST_DEPS_DIR)/unity/src/unity.c) \
	$(wildcard $(TEST_DIR)/unity/src/unity.c) \
	$(wildcard $(TEST_DIR)/unity/unity.c) \
	$(wildcard $(EXT_DEPS_DIR)/unity/src/unity.c) \
), $(TEST_DEPS_DIR)/unity/src/unity.c)

CMOCK_SRCS = $(or $(firstword \
	$(wildcard $(TEST_DEPS_DIR)/cmock/src/cmock.c) \
	$(wildcard $(TEST_DIR)/cmock/src/cmock.c) \
	$(wildcard $(TEST_DIR)/cmock/cmock.c) \
	$(wildcard $(EXT_DEPS_DIR)/cmock/src/cmock.c) \
), $(TEST_DEPS_DIR)/cmock/src/cmock.c)

# Test sources
TEST_UNIT_SRCS = $(strip $(wildcard $(TEST_DIR)/unit/*.c) $(wildcard $(TEST_DIR)/unit/*/*.c) $(wildcard $(TEST_DIR)/unit/*/*/*.c))
TEST_E2E_SRCS  = $(strip $(wildcard $(TEST_DIR)/e2e/*.c) $(wildcard $(TEST_DIR)/e2e/*/*.c) $(wildcard $(TEST_DIR)/e2e/*/*/*.c))

# App sources for tests (excluding main and boot files)
APP_SRCS = $(strip $(filter-out $(SRC_DIR)/rom_header.c $(SRC_DIR)/main.c, $(SRC_C)))

# Test include directories & compiler flags
TEST_INCS = -I. -I$(INC_DIR) -I$(SRC_DIR) -I$(RES_DIR) \
	-I$(TEST_DIR) -I$(TEST_DIR)/unit -I$(TEST_DIR)/e2e \
	-I$(TEST_DIR)/inc -I$(TEST_DIR)/mocks \
	-I$(TEST_DEPS_DIR)/unity/src \
	-I$(TEST_DEPS_DIR)/cmock/src \
	-I$(TEST_DIR)/unity -I$(TEST_DIR)/unity/src \
	-I$(TEST_DIR)/cmock -I$(TEST_DIR)/cmock/src \
	-I$(EXT_DEPS_DIR)/unity/src \
	-I$(EXT_DEPS_DIR)/cmock/src \
	-I$(GDK)/inc \
	$(addprefix -I,$(DEP_INC_DIRS))

TEST_CFLAGS := $(TEST_INCS) -DUNIT_TESTS -DCMOCK -DUNITY_INCLUDE_CONFIG_H -g -O0 -Wall -Wextra -fno-builtin

vpath %.c $(TEST_DIR)/e2e $(TEST_DIR)/e2e/* $(TEST_DIR)/e2e/*/* $(TEST_DEPS_DIR)/unity/src $(TEST_DEPS_DIR)/cmock/src $(SRC_DIR) $(SRC_DIR)/* $(SRC_DIR)/*/* .

E2E_SRCS_ALL := $(TEST_E2E_SRCS) $(UNITY_SRCS) $(CMOCK_SRCS) $(APP_SRCS)
E2E_OBJS_ALL := $(addprefix $(TEST_OUT_DIR)/e2e/, $(notdir $(E2E_SRCS_ALL:.c=.o)))

$(TEST_OUT_DIR)/e2e/%.o: %.c
	@$(MKDIR) -p $(dir $@)
	$(CC) $(FLAGS) $(TEST_INCS) -DUNIT_TESTS -DCMOCK -DUNITY_INCLUDE_CONFIG_H -c $< -o $@


.PHONY: default
.PHONY: all
.PHONY: release
.PHONY: Release
.PHONY: debug
.PHONY: Debug
.PHONY: asm
.PHONY: Asm
.PHONY: clean
.PHONY: clean-release
.PHONY: clean-debug
.PHONY: clean-asm
.PHONY: clean-all
.PHONY: clean-test
.PHONY: install
.PHONY: install-test-deps
.PHONY: test test-unit test_unit unit-test test-e2e test_e2e e2e-test test-coverage test_coverage coverage

default: release
all: release

# include ext.mk if it exists (better to do it after first / default definition)
ifneq ("$(wildcard $(GDK)/ext.mk)","")
    include $(GDK)/ext.mk
endif

Release: release
Debug: debug
Asm: asm
clean: clean-all

release: install
debug: install
asm: install

install:
	@if [ -n "$(DEPENDENCIES)" ]; then \
		$(MKDIR) -p $(EXT_DEPS_DIR); \
		for dep in $(DEPENDENCIES); do \
			case "$$dep" in \
				*.git@*|*://*@*) \
					url=$${dep%@*}; \
					ref=$${dep#*@}; \
					name=$${url##*/}; \
					name=$${name%.git}; \
					if [ ! -d "$(EXT_DEPS_DIR)/$$name" ]; then \
						$(ECHO) "Clonando $$name ($$ref)"; \
						$(GIT) clone "$$url" "$(EXT_DEPS_DIR)/$$name"; \
						$(GIT) -C "$(EXT_DEPS_DIR)/$$name" checkout "$$ref"; \
					fi; \
					;; \
				*.git|*://*) \
					url=$$dep; \
					name=$${url##*/}; \
					name=$${name%.git}; \
					if [ ! -d "$(EXT_DEPS_DIR)/$$name" ]; then \
						$(ECHO) "Clonando $$name"; \
						$(GIT) clone "$$url" "$(EXT_DEPS_DIR)/$$name"; \
					fi; \
					;; \
				*) \
					if [ -d "$$dep" ]; then \
						name=$${dep##*/}; \
						if [ ! -d "$(EXT_DEPS_DIR)/$$name" ]; then \
							$(ECHO) "Dependencia local $$dep"; \
							$(CP) -r "$$dep" "$(EXT_DEPS_DIR)/$$name"; \
						fi; \
					elif [ ! -d "$(EXT_DEPS_DIR)/$$dep" ]; then \
						$(ECHO) "ERROR: dependencia no encontrada: $$dep"; \
						exit 1; \
					fi; \
					;; \
			esac; \
		done; \
	fi

release: $(OUT_DIR)/rom.bin $(OUT_DIR)/symbol.txt
release: padROM
.PHONY: padROM

debug: $(OUT_DIR)/rom.bin $(OUT_DIR)/symbol.txt
debug: injectSymbolsInROM
debug: padROM
.PHONY: injectSymbolsInROM

asm: $(OBJS) $(LSTS)

clean-all:
	$(RM) -r -f out

clean-release: clean-task
clean-debug: clean-task
clean-asm: clean-task
clean-test:
	$(RM) -r -f out/test

clean-task:
	$(RM) -r -f $(OUT_DIR)
.PHONY: clean-task

install-test-deps:
	@$(MKDIR) -p $(TEST_DEPS_DIR)
	@if [ ! -d "$(TEST_DEPS_DIR)/unity" ] && [ ! -d "$(TEST_DEPS_DIR)/Unity" ]; then \
		$(ECHO) "Clonando Unity..."; \
		$(GIT) clone https://github.com/ThrowTheSwitch/Unity.git "$(TEST_DEPS_DIR)/unity"; \
	fi
	@if [ ! -d "$(TEST_DEPS_DIR)/cmock" ] && [ ! -d "$(TEST_DEPS_DIR)/CMock" ]; then \
		$(ECHO) "Clonando CMock..."; \
		$(GIT) clone https://github.com/ThrowTheSwitch/CMock.git "$(TEST_DEPS_DIR)/cmock"; \
	fi

test: test-unit test-e2e

test-unit: test_unit
unit-test: test_unit
ifeq ($(OS),Windows_NT)
test_unit: install install-test-deps
	@if [ -n "$(TEST_UNIT_SRCS)" ]; then \
		$(MKDIR) -p $(TEST_OUT_DIR)/unit; \
		$(TEST_CC) $(TEST_CFLAGS) $(TEST_UNIT_SRCS) $(UNITY_SRCS) $(CMOCK_SRCS) $(APP_SRCS) -o $(TEST_OUT_DIR)/unit/unit_tests$(EXE_EXT); \
		$(ECHO) "[SGDK] Executing unit tests binary..."; \
		$(TEST_OUT_DIR)/unit/unit_tests$(EXE_EXT) || $(TEST_OUT_DIR)/unit/unit_tests$(EXE_EXT); \
	else \
		$(ECHO) "[SGDK] No unit test sources found in $(TEST_DIR)/unit."; \
	fi
else
test_unit: install install-test-deps
	@if [ -n "$(TEST_UNIT_SRCS)" ]; then \
		$(MKDIR) -p $(TEST_OUT_DIR)/unit; \
		$(TEST_CC) $(TEST_CFLAGS) $(TEST_UNIT_SRCS) $(UNITY_SRCS) $(CMOCK_SRCS) $(APP_SRCS) -o $(TEST_OUT_DIR)/unit/unit_tests$(EXE_EXT); \
		$(ECHO) "[SGDK] Executing unit tests binary..."; \
		./$(TEST_OUT_DIR)/unit/unit_tests$(EXE_EXT) > $(TEST_OUT_DIR)/unit/unity_output.txt 2>&1 || true; \
		cat $(TEST_OUT_DIR)/unit/unity_output.txt; \
		$(ECHO) "[SGDK] Generating JUnit XML report..."; \
		awk 'BEGIN { tests = 0; failures = 0; skipped = 0; xml_cases = ""; } { sub(/\r$$/, ""); if ($$0 ~ /^[^:\n]+:[0-9]+:[^:\n]+:(PASS|FAIL|IGNORE)/) { split($$0, parts, ":"); filepath = parts[1]; line = parts[2]; testname = parts[3]; status = parts[4]; n = split(filepath, path_parts, "[\/\\\\]"); file_name = path_parts[n]; sub(/\.[^.]+$$/, "", file_name); tests++; xml_cases = xml_cases "    <testcase classname=\"" file_name "\" name=\"" testname "\" time=\"0.000\">\n"; if (status == "FAIL") { failures++; msg = ""; for (i = 5; i <= length(parts); i++) msg = (i == 5) ? parts[i] : msg ":" parts[i]; sub(/^[ \t]+/, "", msg); sub(/[ \t]+$$/, "", msg); if (msg == "") msg = "Test failed"; xml_cases = xml_cases "      <failure message=\"" msg "\">" filepath ":" line ": " msg "</failure>\n"; } else if (status == "IGNORE") { skipped++; msg = ""; for (i = 5; i <= length(parts); i++) msg = (i == 5) ? parts[i] : msg ":" parts[i]; sub(/^[ \t]+/, "", msg); sub(/[ \t]+$$/, "", msg); if (msg == "") msg = "Test ignored"; xml_cases = xml_cases "      <skipped message=\"" msg "\"/>\n"; } xml_cases = xml_cases "    </testcase>\n"; } } END { print "<?xml version=\"1.0\" encoding=\"UTF-8\"?>"; print "<testsuites tests=\"" tests "\" failures=\"" failures "\" skipped=\"" skipped "\">"; print "  <testsuite name=\"unit_tests\" tests=\"" tests "\" failures=\"" failures "\" skipped=\"" skipped "\">"; printf "%s", xml_cases; print "  </testsuite>"; print "</testsuites>"; }' $(TEST_OUT_DIR)/unit/unity_output.txt > $(TEST_OUT_DIR)/unit/junit.xml; \
		$(ECHO) "[SGDK] Created JUnit report: $(TEST_OUT_DIR)/unit/junit.xml"; \
		if grep -q "FAIL" $(TEST_OUT_DIR)/unit/unity_output.txt 2>/dev/null; then exit 1; fi; \
	else \
		$(ECHO) "[SGDK] No unit test sources found in $(TEST_DIR)/unit."; \
	fi
endif

test-coverage: test_coverage
coverage: test_coverage
ifeq ($(OS),Windows_NT)
test_coverage:
	@$(ECHO) "[ERROR] Coverage analysis target is only supported on Linux."
	@exit 1
else
test_coverage: install install-test-deps
	@if [ -n "$(TEST_UNIT_SRCS)" ]; then \
		$(MKDIR) -p $(TEST_OUT_DIR)/coverage; \
		$(TEST_CC) $(TEST_CFLAGS) --coverage $(TEST_UNIT_SRCS) $(UNITY_SRCS) $(CMOCK_SRCS) $(APP_SRCS) -o $(TEST_OUT_DIR)/coverage/unit_tests$(EXE_EXT); \
		$(ECHO) "[SGDK] Executing unit tests binary with coverage..."; \
		./$(TEST_OUT_DIR)/coverage/unit_tests$(EXE_EXT) > $(TEST_OUT_DIR)/coverage/unity_output.txt 2>&1 || true; \
		cat $(TEST_OUT_DIR)/coverage/unity_output.txt; \
		if command -v gcov >/dev/null 2>&1; then \
			$(ECHO) "[SGDK] Running gcov coverage analysis..."; \
			for f in $(APP_SRCS); do \
				gcno=$$(ls $(TEST_OUT_DIR)/coverage/*-$$(basename $${f%.c}).gcno 2>/dev/null); \
				if [ -f "$$gcno" ]; then \
					gcov -o "$$gcno" "$$f"; \
				fi; \
			done; \
			mv -f *.gcov $(TEST_OUT_DIR)/coverage/ 2>/dev/null || true; \
		fi; \
		if command -v gcovr >/dev/null 2>&1; then \
			$(ECHO) "[SGDK] Generating SonarQube coverage report..."; \
			gcovr --filter "inc|src|test" --sonarqube $(TEST_OUT_DIR)/coverage/coverage.xml; \
			$(ECHO) "[SGDK] Created SonarQube coverage report: $(TEST_OUT_DIR)/coverage/coverage.xml"; \
		fi; \
		
		if command -v lcov >/dev/null 2>&1; then \
			$(ECHO) "[SGDK] Capturing lcov coverage report..."; \
			lcov --capture --directory $(TEST_OUT_DIR)/coverage --output-file $(TEST_OUT_DIR)/coverage/coverage.info --ignore-errors unused 2>/dev/null || true; \
			lcov --remove $(TEST_OUT_DIR)/coverage/coverage.info "*/tests/*" "*/deps/*" --ignore-errors unused --output-file $(TEST_OUT_DIR)/coverage/coverage_cleaned.info 2>/dev/null || true; \
			if command -v genhtml >/dev/null 2>&1; then \
				genhtml $(TEST_OUT_DIR)/coverage/coverage_cleaned.info --output-directory $(TEST_OUT_DIR)/coverage/html 2>/dev/null || true; \
				$(ECHO) "[SGDK] Created LCOV HTML report: $(TEST_OUT_DIR)/coverage/html/index.html"; \
			fi; \
		fi; \
	else \
		$(ECHO) "[SGDK] No unit test sources found in $(TEST_DIR)/unit."; \
	fi
endif

test-e2e: test_e2e
e2e-test: test_e2e
test_e2e: install install-test-deps
	@if [ -n "$(TEST_E2E_SRCS)" ]; then \
		$(MKDIR) -p $(TEST_OUT_DIR)/e2e; \
		if [ -f "$(SRC_DIR)/rom_header.c" ]; then \
			$(CC) $(FLAGS) -c $(SRC_DIR)/rom_header.c -o $(TEST_OUT_DIR)/e2e/rom_header.o || exit 1; \
		else \
			$(CP) $(SRC_LIB)/boot/rom_header.c $(TEST_OUT_DIR)/e2e/rom_header.c; \
			$(CC) $(FLAGS) -c $(TEST_OUT_DIR)/e2e/rom_header.c -o $(TEST_OUT_DIR)/e2e/rom_header.o || exit 1; \
		fi; \
		$(OBJCPY) -O binary $(TEST_OUT_DIR)/e2e/rom_header.o $(TEST_OUT_DIR)/e2e/rom_header.bin || exit 1; \
		$(MKDIR) -p out; \
		$(CP) $(TEST_OUT_DIR)/e2e/rom_header.bin out/rom_header.bin; \
		$(CP) $(SRC_LIB)/boot/sega.s $(TEST_OUT_DIR)/e2e/sega.s; \
		$(CC) $(AFLAGS) -c $(TEST_OUT_DIR)/e2e/sega.s -o $(TEST_OUT_DIR)/e2e/sega.o || exit 1; \
		$(MAKE) -f $(MAKEFILE_PATH) $(E2E_OBJS_ALL) || exit 1; \
		$(ECHO) "$(E2E_OBJS_ALL) $(RES_O)" > $(TEST_OUT_DIR)/e2e/cmd_; \
		$(CC) -m68000 -B$(BIN) -n -T $(GDK)/md.ld -nostdlib $(TEST_OUT_DIR)/e2e/sega.o @$(TEST_OUT_DIR)/e2e/cmd_ $(LIBMD) $(LIBGCC) -o $(TEST_OUT_DIR)/e2e/rom.out -Wl,--gc-sections || exit 1; \
		$(NM) $(LTO_PLUGIN) -n -l $(TEST_OUT_DIR)/e2e/rom.out > $(TEST_OUT_DIR)/e2e/symbol.txt 2>/dev/null || true; \
		$(OBJCPY) -O binary $(TEST_OUT_DIR)/e2e/rom.out $(TEST_OUT_DIR)/e2e/rom.bin || exit 1; \
		$(SIZEBND) $(TEST_OUT_DIR)/e2e/rom.bin -sizealign 131072 -checksum; \
		$(ECHO) "[SGDK] Created Mega Drive E2E test ROM: $(TEST_OUT_DIR)/e2e/rom.bin"; \
	else \
		$(ECHO) "[SGDK] No E2E test sources found in $(TEST_DIR)/e2e."; \
	fi


padROM:	$(OUT_DIR)/rom.bin
	$(SIZEBND) $(OUT_DIR)/rom.bin -sizealign 131072 -checksum
	@$(CP) $(OUT_DIR)/rom.bin out/rom.bin

injectSymbolsInROM:	$(OUT_DIR)/rom.bin $(OUT_DIR)/symbol.txt
	$(CONVSYM) $(OUT_DIR)/symbol.txt $(OUT_DIR)/rom.bin -in txt -inopt " /fmt='%X %*[TtBbCcDd] %511s' /offsetFirst+" -range 0 FFFFFF -a -ref @MDDBG__SymbolDataPtr


$(OUT_DIR)/rom.bin: $(OUT_DIR)/rom.out $(OUT_DIR)/symbol.txt
	$(OBJCPY) -O binary $(OUT_DIR)/rom.out $(OUT_DIR)/rom.bin

$(OUT_DIR)/symbol.txt: $(OUT_DIR)/rom.out
	$(NM) $(LTO_PLUGIN) -n -l $(OUT_DIR)/rom.out > $(OUT_DIR)/symbol.txt

$(OUT_DIR)/rom.out: $(OUT_DIR)/sega.o $(OUT_DIR)/cmd_ $(LIBMD)
	@$(MKDIR) -p $(dir $@)
	$(CC) -m68000 -B$(BIN) -n -T $(GDK)/md.ld -nostdlib $(OUT_DIR)/sega.o @$(OUT_DIR)/cmd_ $(LIBMD) $(LIBGCC) -o $(OUT_DIR)/rom.out -Wl,--gc-sections -flto -flto=auto -ffat-lto-objects
	@$(RM) $(OUT_DIR)/cmd_

$(OUT_DIR)/cmd_: $(OBJS)
	@$(MKDIR) -p $(dir $@)
	$(ECHO) "$(OBJS)" > $(OUT_DIR)/cmd_

# NOTE: sega.s references out/rom_header.bin internally
$(OUT_DIR)/sega.o: out/rom_header.bin
	@$(MKDIR) -p $(dir $@)
	$(CP) $(SRC_LIB)/boot/sega.s $(OUT_DIR)/sega.s
	$(CC) $(AFLAGS) -c $(OUT_DIR)/sega.s -o $@

# NOTE: rom_head.bin need to be located in 'out' folder as it's referenced by boot/sega.s
out/rom_header.bin: $(OUT_DIR)/rom_header.o
	$(OBJCPY) -O binary $< $@

$(OUT_DIR)/rom_header.o: $(SRC_DIR)/rom_header.c
	@$(MKDIR) -p $(dir $@)
	$(CC) $(INCS) $(DEFAULT_FLAGS) -c $< -o $@

# SRC_LIB files are "order-only" deps, right of the pipe.  This means we will never overwrite the file in SRC_DIR, even if SRC_LIB is newer.

$(SRC_DIR)/rom_header.c: | $(SRC_LIB)/boot/rom_header.c
	@$(MKDIR) -p $(dir $@)
	$(CP) $| $@


# source / resource compilation
$(OUT_DIR)/%.o: %.c $(DEP_DIR)/%.d
	@$(MKDIR) -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

$(OUT_DIR)/%.o: %.s $(DEP_DIR)/%.d
	@$(MKDIR) -p $(dir $@)
	$(CC) $(AFLAGS) -c $< -o $@

$(OUT_DIR)/%.o: %.asm
	@$(MKDIR) -p $(dir $@)
	$(MACCER) -o $(OUT_DIR)/$*.s $<
	$(CC) $(AFLAGS) -c $(OUT_DIR)/$*.s -o $@

$(OUT_DIR)/%.o: %.s80
	@$(MKDIR) -p $(dir $@)
	$(ASMZ80) $(Z80_FLAGS) $< $(OUT_DIR)/$*.o80 $(OUT_DIR)/out.lst
	$(BINTOS) $(OUT_DIR)/$*.o80 $(OUT_DIR)/$*.s
	$(CC) $(AFLAGS) -c $(OUT_DIR)/$*.s -o $@

$(OUT_DIR)/%.o: %.res
	@$(MKDIR) -p $(dir $@)
	@$(MKDIR) -p $(dir $(DEP_DIR)/$*.d)
	$(RESCOMP) $< $(OUT_DIR)/$*.s -dep $(OUT_DIR)/$*.o
	@$(CP) $(OUT_DIR)/$*.d $(DEP_DIR)/$*.d
	@$(RM) $(OUT_DIR)/$*.d
	@$(CP) $(OUT_DIR)/$*.h $*.h
	@$(RM) $(OUT_DIR)/$*.h
	$(CC) $(AFLAGS) -c $(OUT_DIR)/$*.s -o $@


# listing files
$(OUT_DIR)/%.lst: %.c $(DEP_DIR)/%.d
	@$(MKDIR) -p $(dir $@)
	$(CC) $(CFLAGS) -S -c $< -o $@


# deps files (we want resource to be generated first)
$(DEP_DIR)/%.d: %.c $(RES_O)
	@$(MKDIR) -p $(dir $@)
	$(CC) $(CFLAGS) $< -E -MG -MM -MP -MT $(OUT_DIR)/$*.o -MF $(DEP_DIR)/$*.d

$(DEP_DIR)/%.d: %.s
	@$(MKDIR) -p $(dir $@)
	$(CC) $(AFLAGS) $< -E -MG -MM -MP -MT $(OUT_DIR)/$*.o -MF $(DEP_DIR)/$*.d


ifeq ($(CLEAN),FALSE)
-include $(DEPS)
endif
